    <string name="feature_tracking_disclosure_title">How tracking works</string>
    <string name="feature_tracking_disclosure_intro">To show your app time and reel estimates, ReelCounter needs Android\'s Usage access permission. Here\'s exactly what that means:</string>
    <string name="feature_tracking_disclosure_collects">ReelCounter reads when the apps you choose (TikTok, Instagram, YouTube, Facebook) were open on screen, and for how long, including the past day your phone has already recorded.</string>
    <string name="feature_tracking_disclosure_not_collected">It can\'t see what you watch, read or type, and it never records your screen.</string>
    <string name="feature_tracking_disclosure_other_apps">Usage of every other app is ignored and never stored.</string>
    <string name="feature_tracking_disclosure_storage">Your app time and daily totals stay on this device. Nothing is shared with friends or uploaded.</string>
    <string name="feature_tracking_disclosure_estimates">Reel counts are estimates worked out from app time, and they\'re always labeled as estimates.</string>
    <string name="feature_tracking_disclosure_control">You can pause tracking in Settings or turn off Usage access at any time.</string>
    <string name="feature_tracking_disclosure_accept">Agree and continue</string>

    <string name="feature_tracking_choose_title">Choose apps to track</string>
    <string name="feature_tracking_choose_body">You can change this any time in Settings.</string>

    <string name="feature_tracking_access_title">Turn on Usage access</string>
    <string name="feature_tracking_access_body">Android asks you to allow this in system settings.</string>
    <string name="feature_tracking_access_step_1">Tap Open settings.</string>
    <string name="feature_tracking_access_step_2">Find ReelCounter in the list.</string>
    <string name="feature_tracking_access_step_3">Turn on Permit usage access, then come back.</string>
    <string name="feature_tracking_access_auto_continue">We\'ll continue automatically when you return.</string>

    <!-- Tracking settings -->
